API_ID=1234567
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC-your-bot-token
# Userbot login string from: python login_session.py  (required on cloud hosts)
USER_SESSION=
# PostgreSQL URL (required on cloud hosts; leave empty locally to use a SQLite file)
DATABASE_URL=
# Optional: your Telegram numeric ID (otherwise the first /start user becomes owner)
OWNER_ID=
# Optional: where alerts are posted (channel/group id like -100123..., bot must be admin). Defaults to your DM with the bot.
NOTIFY_CHAT_ID=
# Gemini API key for live AI voice on priority calls (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional overrides
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_VOICE=Puck
MAX_CALL_SECONDS=900
# Model used to transcribe voice messages from watched channels
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
